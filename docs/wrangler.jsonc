{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klens-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "klens.marcocondrache.com", "custom_domain": true }]
}
